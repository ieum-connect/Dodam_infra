COMPOSE_PROJECT_NAME=dodam-production
AWS_REGION=ap-southeast-2
RELEASE_TAG=replace-with-version
# Set these to deploy prebuilt images with independent tags.
BACKEND_IMAGE=
AI_IMAGE=
WEB_IMAGE=
SOURCE_ROOT=../deployment-sources
PLATFORM=linux/amd64
BIND_ADDRESS=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
DOMAIN=replace-with-real-domain
PUBLIC_ORIGIN=https://replace-with-real-domain
NGINX_MODE=bootstrap
COOKIE_SECURE=true
POSTGRES_PASSWORD=replace-with-random-hex
JWT_SECRET=replace-with-random-hex-at-least-64-characters
AI_INTERNAL_TOKEN=replace-with-random-hex
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# Kakao app admin key is needed to unlink Kakao on account withdrawal.
KAKAO_ADMIN_KEY=
PUSH_ENABLED=false
# For push, place service-account.json in this directory on the host.
FIREBASE_SECRETS_DIR=./secrets/firebase
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=
OPENAI_API_KEY=
LLM_API_KEY=
EMBEDDING_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
ISOLATE_NETWORK=false
# Model names must be confirmed with the AI owner before paid calls.
LLM_MODEL=gpt-6-luna
OPENAI_VLM_MODEL=gpt-5.6-sol
EMBEDDING_MODEL=text-embedding-3-small
GOV24_WELFARE_SERVICE_KEY=
